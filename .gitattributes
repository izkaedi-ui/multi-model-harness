# Git Hygiene: track text formatting rules across platforms
* text=auto
*.py text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
