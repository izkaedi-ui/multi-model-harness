# Provider API keys — never commit real values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./harness.db

# Optional: override config directory
HARNESS_CONFIG_DIR=./config

# Optional: override artifacts directory
HARNESS_ARTIFACTS_DIR=./artifacts

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
HARNESS_LOG_LEVEL=INFO
